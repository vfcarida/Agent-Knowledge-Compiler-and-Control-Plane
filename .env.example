# AKCP Environment Variables Configuration
# Copy this file to .env and configure for your local environment

# ==========================================
# Control Plane Settings
# ==========================================
# Enable or disable strict Human-In-The-Loop approvals for side-effect tools
AKCP_REQUIRE_HITL=true

# Dashboard port for the Control Plane
AKCP_DASHBOARD_PORT=3000

# ==========================================
# MCP Server Settings
# ==========================================
# The path to the compiled Knowledge IR json
AKCP_IR_PATH=dist/agent-knowledge-ir.json

# The path to the bundle directory
AKCP_BUNDLE_PATH=./

# ==========================================
# LLM Providers (for Evals and Agents)
# ==========================================
# OpenAI API Key (required for evals and openwiki generation)
OPENAI_API_KEY=

# Anthropic API Key (optional)
ANTHROPIC_API_KEY=

# ==========================================
# Source Connectors (Optional)
# ==========================================
# Confluence connection for knowledge ingestion
CONFLUENCE_DOMAIN=
CONFLUENCE_USER=
CONFLUENCE_API_TOKEN=

# Notion integration token
NOTION_TOKEN=

# ==========================================
# Infrastructure
# ==========================================
# Redis (for ApprovalStore)
REDIS_URL=redis://localhost:6379

# OpenTelemetry (optional, enable with docker compose --profile observability)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=akcp

# Automation Safety
AUTOMATION_RUNTIME_MODE=dry-run

# MCP Servers
MCP_PROFILE_SERVER_PORT=3100
MCP_AUTOMATION_SERVER_PORT=3101

# Dashboard
DASHBOARD_PORT=5173
DASHBOARD_API_PORT=3200
# JWT secret for the dashboard BFF's auth middleware. Required unless DASHBOARD_DEMO_MODE=true.
DASHBOARD_JWT_SECRET=
DASHBOARD_JWT_ISSUER=
DASHBOARD_JWT_AUDIENCE=
# Explicit opt-in to run the dashboard BFF WITHOUT real JWT verification (trusts
# the raw Bearer header as the identity). Never set this in a real deployment.
DASHBOARD_DEMO_MODE=false
# Requests per minute per client IP allowed by the dashboard BFF's rate limiter.
DASHBOARD_RATE_LIMIT=300
# Base URL the dashboard frontend uses to reach its BFF (see src/lib and components/audit).
VITE_API_BASE_URL=http://localhost:3001

# ==========================================
# MCP Profile Server Auth
# ==========================================
# Required unless AKCP_ALLOW_INSECURE_DEV=true — the profile server now fails
# closed (refuses to start) without one of these configured.
AKCP_JWT_SECRET=
AKCP_JWKS_URI=
# Explicit opt-in to run the profile server WITHOUT authentication. Never set
# this in a real deployment.
AKCP_ALLOW_INSECURE_DEV=false
